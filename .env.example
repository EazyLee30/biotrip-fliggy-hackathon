# WHOOP OAuth app (register the callback URL in the WHOOP developer dashboard)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback
# Use a randomly generated secret with at least 32 characters.
WHOOP_COOKIE_SECRET=

# Production prefers Bailian Managed Agents: health, local research, FlyAI inventory,
# then a dedicated tool-free composer. All use standard Bailian credentials, not Token Plan.
# BAILIAN_MODEL_API_KEY optionally separates model permissions from Agent permissions.
# Never put an sk-sp Token Plan key in either Bailian API key variable.
BAILIAN_API_KEY=
BAILIAN_MODEL_API_KEY=
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing
# The model below is only for the standard model API transport; each Managed Agent
# has its own model configuration in Bailian (production currently uses qwen3.8-flash).
BAILIAN_PLAN_MODEL=qwen3.7-flash
# auto prefers the complete Managed Agent configuration; incomplete configuration
# may select the standard model API. Pin managed to require the official Agent Skill path.
# An in-flight failure never restarts the whole pipeline with another transport.
BAILIAN_PLANNING_MODE=auto
# Inventory search Agent with the official read-only FlyAI Skill.
BAILIAN_AGENT_ID=
BAILIAN_ENVIRONMENT_ID=
# Isolated no-tools Agent for interpreting WHOOP metrics before any FlyAI search.
# Create it without skills/tools and without FlyAI credentials in its runtime environment.
BAILIAN_INSIGHT_AGENT_ID=
BAILIAN_INSIGHT_ENVIRONMENT_ID=
# Local services research Agent with web search only (no WHOOP data or FlyAI credential).
BAILIAN_LOCAL_INFO_AGENT_ID=
BAILIAN_LOCAL_INFO_ENVIRONMENT_ID=
# Dedicated tool-free composer; no Skill, MCP, tools or Vault.
BAILIAN_COMPOSE_AGENT_ID=
# Optional: defaults to the health environment, then the inventory environment.
BAILIAN_COMPOSE_ENVIRONMENT_ID=
# Vault ID containing FLYAI_API_KEY; injected only into inventory-search sessions.
BAILIAN_FLYAI_VAULT_ID=
# Worker-only credentials for the read-only FlyAI signature bridge.
# Keep the real API key and official CLI signing configuration in Worker Secrets.
FLYAI_API_KEY=
FLYAI_SIGN_SECRET=

# Resend transactional email. Verify notify.biotrip.eazylee.si in Resend first;
# keep the API key in Cloudflare Worker Secrets, never in client-side code.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BioTrip <login@notify.biotrip.eazylee.si>

# Independent Agent with only the official Amap MCP, no tools/skills/FlyAI Vault.
BAILIAN_MOBILITY_AGENT_ID=
BAILIAN_MOBILITY_ENVIRONMENT_ID=
# Exact MCP server ID from the Agent's session snapshot (not the secret URL).
BAILIAN_MOBILITY_MCP_SERVER_ID=
# Amap Web Service Key belongs in the Bailian MCP service configuration.
# Do not put the key in NEXT_PUBLIC_ variables or this repository.
